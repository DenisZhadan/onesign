{
  "name": "registrucentras/onesign",
  "description": "GoSign OneSign API client for PHP",
  "keywords": [
    "GoSign",
    "OneSign",
    "GoSign API",
    "Elektroninis parašas"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "VĮ Registrų Centras",
      "email": "pagalba@elektroninis.lt"
    }
  ],
  "require": {
    "php": "^7.4 || ^8.0",
    "ext-json": "*",
    "php-http/cache-plugin": "^1.8.1",
    "php-http/client-common": "^2.7.3",
    "php-http/discovery": "^1.20.0",
    "php-http/httplug": "^2.4.1",
    "php-http/multipart-stream-builder": "^1.4.2",
    "psr/cache": "^1.0.1",
    "psr/http-client-implementation": "^1.0",
    "psr/http-factory-implementation": "^1.0",
    "psr/http-message": "^1.1",
    "fig/http-message-util": "^1.1.5",
    "symfony/polyfill-php80": "^v1.33.0",
    "meng-tian/php-soap-interpreter": "^1.0.3",
    "gaarf/xml-to-php-array": "^1.0",
    "spatie/array-to-xml": "^2.17.1"
  },
  "require-dev": {
    "bamarni/composer-bin-plugin": "^1.8.3",
    "guzzlehttp/guzzle": "^7.10",
    "http-interop/http-factory-guzzle": "^1.2.0",
    "php-http/mock-client": "^1.6.1"
  },
  "autoload": {
    "psr-4": {
      "RegistruCentras\\OneSign\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "RegistruCentras\\OneSign\\Tests\\": "tests/"
    }
  },
  "config": {
    "preferred-install": "dist",
    "allow-plugins": {
      "bamarni/composer-bin-plugin": true
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit phpstan-analyze psalm-analyze rector-dry-run",
    "phpcs": "vendor/bin/phpcs",
    "phpcbf": "vendor/bin/phpcbf",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon",
    "test-coverage": "vendor/bin/phpunit --coverage-html coverage"
  }
}
